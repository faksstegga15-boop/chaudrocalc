# En-têtes de cache Netlify (ignoré par GitHub Pages)
# Polices et icônes : ne changent jamais sous le même nom, gardées un an sans revérification.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
# Service worker et pages : toujours revérifiés, pour que les mises à jour arrivent tout de suite.
/sw.js
  Cache-Control: no-cache
/*.html
  Cache-Control: public, max-age=0, must-revalidate
